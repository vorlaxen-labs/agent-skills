{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/vorlaxen-labs/Agent-Skills/main/docs/schemas/agent-skills-hubs-subscription-v1.schema.json",
  "title": "Vorlaxen Agent Skills hub subscriptions",
  "description": "Local hub subscriptions (agent-skills-hubs.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "hubs"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "const": 1 },
    "hubs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/hubSubscription" }
    }
  },
  "$defs": {
    "hubSubscription": {
      "type": "object",
      "required": ["hubId", "source", "ref", "manifestPath", "addedAt"],
      "additionalProperties": false,
      "properties": {
        "hubId": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "manifestPath": { "type": "string", "minLength": 1 },
        "addedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
