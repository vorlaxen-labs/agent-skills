{
  "name": "@vorlaxen-labs/agent-skills",
  "version": "3.0.0",
  "description": "Vorlaxen Agent Skills CLI — init global engineering standards, add and update skills from any GitHub repo for Cursor, Claude Code, Copilot, and more",
  "author": "Vorlaxen Labs",
  "license": "MIT",
  "homepage": "https://github.com/vorlaxen-labs/Agent-Skills#readme",
  "bugs": {
    "url": "https://github.com/vorlaxen-labs/Agent-Skills/issues"
  },
  "type": "module",
  "bin": {
    "agent-skills": "dist/cli.js"
  },
  "files": [
    "dist",
    "bundled",
    "docs/schemas"
  ],
  "scripts": {
    "build": "node scripts/bundle-skills.mjs && tsc",
    "dev": "tsx src/cli.ts",
    "test": "npm run build && node scripts/run-tests.mjs",
    "check:sync": "node scripts/check-sync.mjs",
    "check": "npm run check:sync && npm run check:bundled",
    "check:bundled": "node scripts/check-bundled.mjs",
    "ci": "npm run check && npm test",
    "prepublishOnly": "npm run build && npm run ci"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorlaxen-labs/Agent-Skills.git"
  },
  "keywords": [
    "agent-skills",
    "agents-md",
    "ai-coding",
    "ai-agents",
    "claude-code",
    "codex",
    "copilot",
    "cursor",
    "cursor-rules",
    "developer-tools",
    "engineering-standards",
    "gemini-cli",
    "llm",
    "npx",
    "skills",
    "windsurf"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.5.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
