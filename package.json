{
  "name": "@vorlaxen-labs/agent-skills",
  "version": "3.0.4",
  "description": "Agent skills CLI: init AGENTS.md standards, add SKILL.md packs from any GitHub repo for Cursor, Claude Code, Copilot, Windsurf, Codex, Gemini — hubs, doctor, skills-lock.json",
  "author": "Vorlaxen Labs",
  "license": "MIT",
  "homepage": "https://github.com/vorlaxen-labs/agent-skills#readme",
  "bugs": {
    "url": "https://github.com/vorlaxen-labs/agent-skills/issues"
  },
  "type": "module",
  "bin": {
    "agent-skills": "dist/cli.js"
  },
  "files": [
    "dist",
    "bundled",
    "docs/schemas"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/bundle-skills.mjs && tsc",
    "dev": "tsx src/cli.ts",
    "test": "npm run build && node scripts/run-tests.mjs",
    "check:sync": "node scripts/check-sync.mjs",
    "check": "npm run check:sync && npm run build && npm run check:bundled",
    "check:bundled": "node scripts/check-bundled.mjs",
    "ci": "npm run check && npm test",
    "prepublishOnly": "npm run build && npm run ci",
    "release:dry-run": "semantic-release --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorlaxen-labs/agent-skills.git"
  },
  "keywords": [
    "agent-skills",
    "agents-md",
    "ai-coding",
    "ai-agents",
    "claude-code",
    "codex",
    "copilot",
    "cursor",
    "cursor-rules",
    "developer-tools",
    "engineering-standards",
    "gemini-cli",
    "llm",
    "npx",
    "skills",
    "windsurf",
    "agents-md",
    "skill-md",
    "skills-lock",
    "github-copilot",
    "openai-codex"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.5.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^22.20.1",
    "semantic-release": "^25.0.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
